    },
    {
      "id": "sub_0",
      "type": "text",
      "x": 250,
      "y": 170,
      "width": 1500,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 962963,
      "version": 2,
      "versionNonce": 237016858,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788163650146,
      "link": null,
      "locked": false,
      "text": "A scalable, high-throughput file upload platform enabling direct-to-storage client uploads, resumable\nmultipart transfers, asynchronous post-processing (virus scan, thumbnails), and edge-cached distribution.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A scalable, high-throughput file upload platform enabling direct-to-storage client uploads, resumable\nmultipart transfers, asynchronous post-processing (virus scan, thumbnails), and edge-cached distribution.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a1"
    },
    {
      "id": "func_reqs",
      "type": "text",
      "x": 250,
      "y": 280,
      "width": 420,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1071605,
      "version": 2,
      "versionNonce": 1395359622,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788163650146,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n\n1. Direct client upload to object storage\n   (bypass server bandwidth bottleneck)\n2. Presigned URL generation & authentication\n3. Support multipart & chunked uploads\n4. Track upload lifecycle & metadata\n   (Pending -> Processing -> Ready | Failed)\n5. Asynchronous post-processing\n   (Virus scanning, thumbnail generation)\n6. Fast, edge-cached file delivery via CDN",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n\n1. Direct client upload to object storage\n   (bypass server bandwidth bottleneck)\n2. Presigned URL generation & authentication\n3. Support multipart & chunked uploads\n4. Track upload lifecycle & metadata\n   (Pending -> Processing -> Ready | Failed)\n5. Asynchronous post-processing\n   (Virus scanning, thumbnail generation)\n6. Fast, edge-cached file delivery via CDN",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a2"
    },
    {
      "id": "non_func_reqs",
      "type": "text",
      "x": 250,
      "y": 600,
      "width": 420,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1180247,
      "version": 2,
      "versionNonce": 1727177690,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788163650146,
      "link": null,
      "locked": false,
      "text": "Non-Functional Requirements\n\n1. Low Latency\n   Presigned URL generation < 50 ms\n2. High Availability\n   99.99% for initiation API\n3. Scalability\n   Tens of thousands of concurrent uploads\n4. Fault Tolerance\n   Resumable chunked uploads\n5. Security\n   Short-lived tokens, virus isolation\n6. Cost Efficiency\n   Offload raw data transfer to S3/GCS",
      "fontSize": 19,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional Requirements\n\n1. Low Latency\n   Presigned URL generation < 50 ms\n2. High Availability\n   99.99% for initiation API\n3. Scalability\n   Tens of thousands of concurrent uploads\n4. Fault Tolerance\n   Resumable chunked uploads\n5. Security\n   Short-lived tokens, virus isolation\n6. Cost Efficiency\n   Offload raw data transfer to S3/GCS",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a3"
    },
    {
      "id": "api_spec",
      "type": "text",
      "x": 250,
      "y": 960,
      "width": 389.627685546875,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1288889,
      "version": 3,
      "versionNonce": 177284698,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788163825979,
      "link": null,
      "locked": false,
      "text": "API Specification\n\nPOST /v1/files:initiate\n{\n  \"filename\": \"video.mp4\",\n  \"fileSize\": 104857600,\n  \"contentType\": \"video/mp4\",\n  \"checksum\": \"sha256:abc...\"\n}\n->\n{\n  \"fileId\": \"f_12345\",\n  \"uploadUrl\": \"https://s3.amazonaws.com/...\",\n  \"expiresAt\": \"2026-08-31T01:15:00Z\"\n}\n\nPOST /v1/files/{fileId}:complete\n{ \"parts\": [...] }\n->\n{ \"status\": \"PROCESSING\" }",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API Specification\n\nPOST /v1/files:initiate\n{\n  \"filename\": \"video.mp4\",\n  \"fileSize\": 104857600,\n  \"contentType\": \"video/mp4\",\n  \"checksum\": \"sha256:abc...\"\n}\n->\n{\n  \"fileId\": \"f_12345\",\n  \"uploadUrl\": \"https://s3.amazonaws.com/...\",\n  \"expiresAt\": \"2026-08-31T01:15:00Z\"\n}\n\nPOST /v1/files/{fileId}:complete\n{ \"parts\": [...] }\n->\n{ \"status\": \"PROCESSING\" }",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a4"
    },
