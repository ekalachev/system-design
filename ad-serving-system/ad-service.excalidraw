      "text": "AD SERVING SYSTEM",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AD SERVING SYSTEM",
      "autoResize": true,
